# 大模型（OpenAI 兼容）。二选一，改完后必须重启 uvicorn。

# 智谱 GLM-4.7-Flash（国内，免费档并发约 1）
# 密钥：https://open.bigmodel.cn
LLM_API_KEY=
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-4.7-flash

# DeepSeek V4 Flash（测试可改用下面三行，注释掉上面的 BASE_URL / MODEL，并换成 DeepSeek 密钥）
# 密钥：https://platform.deepseek.com
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-v4-flash

# 职位缓存小时数；向公开页请求的最小间隔（秒）
CACHE_TTL_HOURS=8
REQUEST_INTERVAL_SECONDS=1.5

# 给同学访问时必填。本机开发可留空。
# 生成：python3 -c "import secrets; print(secrets.token_urlsafe(12))"
ACCESS_TOKEN=
